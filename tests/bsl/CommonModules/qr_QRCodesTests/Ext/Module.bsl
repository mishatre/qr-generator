////////////////////////////////////////////////////////////////////////////////
// Тестовый набор YAxUnit для компоненты «Генератор QR-кодов».
//
// Набор не входит в релизную сборку расширения: tests/bsl/run-tests.sh собирает
// тестовую сборку из релизного дерева src/cfe/QrGenerator и этого модуля,
// зарегистрированного в Configuration.xml.
//
// Запуск требует лицензии 1С: тесты выполняются в платформе, и у расширения должны
// быть сняты признаки «Безопасный режим» и «Защита от опасных действий» - в безопасном
// режиме внешнюю компоненту подключить нельзя.
//
// Проверяется стык с платформой: подключение компоненты, двоичные данные вместо
// изображения, текст причины вместо отказа. Изображения набор не декодирует.
//
// BSLLS:LatinAndCyrillicSymbolInWord-off
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Регистрация тестов набора. YAxUnit вызывает эту процедуру, чтобы узнать, какие
// методы модуля являются тестами: в BSL нет рефлексии, поэтому список задается
// явно.
//
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ДобавитьТест("КомпонентаПодключается")
		.ДобавитьТест("КомпонентаQRКодаВозвращается")
		.ДобавитьТест("ПолноеИмяОбъектаКомпонентыРаботает")
		.ДобавитьТест("ИзображениеСоздается")
		.ДобавитьТест("ОдинаковыеДанныеДаютОдинаковыйРазмер")
		.ДобавитьТест("РазныеДанныеДаютРазныеИзображения")
		.ДобавитьТест("ВизуальныйКодЭтоПоследниеЧетыреСимвола")
		.ДобавитьТест("ПроверочныйКодСчитаетсяПоОснове")
		.ДобавитьТест("КодВеренПроверяетЗапись")
		.ДобавитьТест("ИдентификаторЭкземпляраВыдается")
		.ДобавитьТест("НастройкиСодержатВсеПоля")
		.ДобавитьТест("НастройкиПереводятсяНаАнглийский")
		.ДобавитьТест("РазмерМеняетИзображение")
		.ДобавитьТест("ПодписьМеняетИзображение")
		.ДобавитьТест("ПустыеДанныеДаютИсключениеСТекстомПричины")
		.ДобавитьТест("СлишкомДлинныеДанныеДаютИсключение")
		.ДобавитьТест("НеизвестнаяНастройкаДаетИсключение")
		.ДобавитьТест("НедопустимаяНастройкаДаетИсключение")
		.ДобавитьТест("ОтказНеЛомаетСледующийВызов");
		
КонецПроцедуры

// Подключение компоненты - предварительное условие для всех остальных тестов.
// Признака «компонента подключена» у обертки нет: общий модуль расширения не может
// хранить состояние, поэтому подключение подтверждается чтением версии.
//
Процедура КомпонентаПодключается() Экспорт
	
	ЮТест.ОжидаетЧто(qr_QRCode.ВерсияКомпоненты()).Заполнено();
	
КонецПроцедуры

// Компоненту подключает модуль qr_QRCodeСерверПовтИсп, в котором подключение
// повторно используется за сеанс.
//
Процедура КомпонентаQRКодаВозвращается() Экспорт
	
	Компонента = qr_QRCodeСерверПовтИсп.ПодключитьКомпонентуQRКода();
	
	ЮТест.ОжидаетЧто(ТипЗнч(Компонента)).Равно(Тип("ВнешняяКомпонента"));
	ЮТест.ОжидаетЧто(Компонента.Версия()).Заполнено();
	
КонецПроцедуры

// Полное имя объекта компоненты - часть контракта: проверяется и сама строка, и то,
// что по этому имени объект создается.
//
Процедура ПолноеИмяОбъектаКомпонентыРаботает() Экспорт
	
	ПолноеИмя = qr_QRCode.ПолноеИмяОбъектаКомпоненты();
	
	ЮТест.ОжидаетЧто(ПолноеИмя).Равно("AddIn.QrGenerator.QrGenerator");
	ЮТест.ОжидаетЧто(ТипЗнч(Новый(ПолноеИмя))).Равно(Тип("ВнешняяКомпонента"));
	
КонецПроцедуры

// Созданное изображение приходит двоичными данными.
//
Процедура ИзображениеСоздается() Экспорт
	
	Изображение = qr_QRCode.СоздатьQRКод(ДанныеЗаписи(), ВизуальныйКодЗаписи());
	
	ЮТест.ОжидаетЧто(Изображение).ИмеетТип("ДвоичныеДанные");
	ЮТест.ОжидаетЧто(Изображение.Размер() > 0).Равно(Истина);
	
КонецПроцедуры

// Одинаковые данные дают одинаковое изображение: сравниваются размеры, а не байты.
//
Процедура ОдинаковыеДанныеДаютОдинаковыйРазмер() Экспорт
	
	Первый = qr_QRCode.СоздатьQRКод(ДанныеЗаписи(), ВизуальныйКодЗаписи());
	Второй = qr_QRCode.СоздатьQRКод(ДанныеЗаписи(), ВизуальныйКодЗаписи());
	
	ЮТест.ОжидаетЧто(Второй.Размер()).Равно(Первый.Размер());
	
КонецПроцедуры

// Разные данные дают разные изображения.
//
Процедура РазныеДанныеДаютРазныеИзображения() Экспорт
	
	ОднаЗапись = qr_QRCode.СоздатьQRКод(ОсноваЗаписи() + "AAA1", "AAA1");
	ДругаяЗапись = qr_QRCode.СоздатьQRКод(ОсноваЗаписи() + "BBB2", "BBB2");
	
	ЮТест.ОжидаетЧто(ДругаяЗапись.Размер() = ОднаЗапись.Размер()).Равно(Ложь);
	
КонецПроцедуры

// Визуальный код - последние четыре символа записи. Он печатается подписью и должен
// совпадать с тем, что видит оператор в строке данных.
//
Процедура ВизуальныйКодЭтоПоследниеЧетыреСимвола() Экспорт
	
	ДлинаКода = 4;
	
	ЮТест.ОжидаетЧто(qr_QRCode.ВизуальныйКод(ДанныеЗаписи())).Равно(ВизуальныйКодЗаписи());
	ЮТест.ОжидаетЧто(qr_QRCode.ВизуальныйКод(ДанныеЗаписи())).ИмеетДлину(ДлинаКода);
	
	// У короткой строки возвращается вся строка.
	ЮТест.ОжидаетЧто(qr_QRCode.ВизуальныйКод("AB")).Равно("AB");
	
КонецПроцедуры

// Проверочный код считается по основе записи, то есть по записи без самого кода.
//
Процедура ПроверочныйКодСчитаетсяПоОснове() Экспорт
	
	ЮТест.ОжидаетЧто(qr_QRCode.ПроверочныйКод(ОсноваЗаписи())).Равно(ВизуальныйКодЗаписи());
	ЮТест.ОжидаетЧто(qr_QRCode.ПроверочныйКод("ORDER-2026-0001")).Равно("6PFM");
	
КонецПроцедуры

// КодВерен отвечает на вопрос, цела ли запись: он пересчитывает код по данным и
// сравнивает с тем, что стоит в конце записи.
//
Процедура КодВеренПроверяетЗапись() Экспорт
	
	ЮТест.ОжидаетЧто(qr_QRCode.КодВерен(ДанныеЗаписи())).Равно(Истина);
	
	// Изменение одного символа данных делает запись неверной.
	ЮТест.ОжидаетЧто(qr_QRCode.КодВерен(СтрЗаменить(ДанныеЗаписи(), "|1", "|2"))).Равно(Ложь);
	
	// У строки короче кода возвращается Ложь.
	ЮТест.ОжидаетЧто(qr_QRCode.КодВерен("AA")).Равно(Ложь);
	
КонецПроцедуры

// Идентификатор выдает компонента: он состоит из символов того же алфавита, что и коды.
//
Процедура ИдентификаторЭкземпляраВыдается() Экспорт
	
	ДлинаИдентификатора = 8;
	
	Первый = qr_QRCode.ИдентификаторЭкземпляра();
	Второй = qr_QRCode.ИдентификаторЭкземпляра();
	
	ЮТест.ОжидаетЧто(Первый).ИмеетДлину(ДлинаИдентификатора);
	ЮТест.ОжидаетЧто(Первый = Второй).Равно(Ложь);
	ЮТест.ОжидаетЧто(СтрДлина(СтрЗаменить(Первый, "0", ""))).Равно(ДлинаИдентификатора);
	
КонецПроцедуры

// Проверяется весь список настроек.
//
Процедура НастройкиСодержатВсеПоля() Экспорт
	
	ЧислоНастроек = 11;
	
	Настройки = qr_QRCode.НастройкиПоУмолчанию();
	
	ЮТест.ОжидаетЧто(Настройки).ИмеетТип("Структура");
	ЮТест.ОжидаетЧто(Настройки).ИмеетДлину(ЧислоНастроек);
	
	ЮТест.ОжидаетЧто(Настройки).Свойство("Размер");
	ЮТест.ОжидаетЧто(Настройки).Свойство("УровеньКоррекцииОшибок");
	ЮТест.ОжидаетЧто(Настройки).Свойство("ЗонаПокоя");
	ЮТест.ОжидаетЧто(Настройки).Свойство("РазмерПодписи");
	ЮТест.ОжидаетЧто(Настройки).Свойство("ОтступПодписи");
	ЮТест.ОжидаетЧто(Настройки).Свойство("СкруглениеПодписи");
	ЮТест.ОжидаетЧто(Настройки).Свойство("СтрокПодписи");
	ЮТест.ОжидаетЧто(Настройки).Свойство("ЦветКода");
	ЮТест.ОжидаетЧто(Настройки).Свойство("Фон");
	ЮТест.ОжидаетЧто(Настройки).Свойство("ЦветПодписи");
	ЮТест.ОжидаетЧто(Настройки).Свойство("ФонПодписи");
	
	// Подпись по умолчанию занимает 0.3 стороны изображения.
	РазмерПодписиПоУмолчанию = 0.3;
	
	ЮТест.ОжидаетЧто(Настройки.РазмерПодписи).Равно(РазмерПодписиПоУмолчанию);
	
КонецПроцедуры

// Имена настроек переводятся, а значения нет.
//
Процедура НастройкиПереводятсяНаАнглийский() Экспорт
	
	Русские = qr_QRCode.НастройкиПоУмолчанию();
	Английские = qr_QRCode.НастройкиПоУмолчанию("en");
	
	ЮТест.ОжидаетЧто(Английские).ИмеетДлину(Русские.Количество());
	ЮТест.ОжидаетЧто(Английские).Свойство("Size");
	ЮТест.ОжидаетЧто(Английские).Свойство("LabelSize");
	
	// Значения от языка не зависят: цвета и уровень коррекции задаются строками.
	ЮТест.ОжидаетЧто(Английские.Size).Равно(Русские.Размер);
	ЮТест.ОжидаетЧто(Английские.Foreground).Равно(Русские.ЦветКода);
	
	// Неизвестный язык вызывает исключение.
	ТекстОшибки = "";
	
	Попытка
		qr_QRCode.НастройкиПоУмолчанию("de");
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	Если ПустаяСтрока(ТекстОшибки) Тогда
		ВызватьИсключение "Неизвестный язык настроек остался незамеченным.";
	КонецЕсли;
	
КонецПроцедуры

// Настройка размера доходит до компоненты.
//
Процедура РазмерМеняетИзображение() Экспорт
	
	РазмерМалый = 300;
	РазмерБольшой = 600;
	
	Настройки = qr_QRCode.НастройкиПоУмолчанию();
	
	Настройки.Размер = РазмерМалый;
	Малое = qr_QRCode.СоздатьQRКод(ДанныеЗаписи(), ВизуальныйКодЗаписи(), Настройки);
	
	Настройки.Размер = РазмерБольшой;
	Большое = qr_QRCode.СоздатьQRКод(ДанныеЗаписи(), ВизуальныйКодЗаписи(), Настройки);
	
	ЮТест.ОжидаетЧто(Большое.Размер() > Малое.Размер()).Равно(Истина);
	
КонецПроцедуры

// Подпись рисуется поверх кода: изображение меняется, а данные в коде остаются
// прежними.
//
Процедура ПодписьМеняетИзображение() Экспорт
	
	БезПодписи = qr_QRCode.СоздатьQRКод(ДанныеЗаписи(), "");
	СПодписью = qr_QRCode.СоздатьQRКод(ДанныеЗаписи(), ВизуальныйКодЗаписи());
	
	ЮТест.ОжидаетЧто(БезПодписи.Размер() > 0).Равно(Истина);
	ЮТест.ОжидаетЧто(СПодписью.Размер() = БезПодписи.Размер()).Равно(Ложь);
	
КонецПроцедуры

// Пустые данные вызывают исключение, причина приходит текстом.
//
Процедура ПустыеДанныеДаютИсключениеСТекстомПричины() Экспорт
	
	ТекстОшибки = "";
	
	Попытка
		qr_QRCode.СоздатьQRКод("", "");
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	ЮТест.ОжидаетЧто(ТекстОшибки).Заполнено();
	ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, "данн") > 0).Равно(Истина);
	
КонецПроцедуры

// Данные длиннее самого большого QR-кода вызывают исключение.
//
Процедура СлишкомДлинныеДанныеДаютИсключение() Экспорт
	
	ТекстОшибки = "";
	
	Попытка
		qr_QRCode.СоздатьQRКод(ДлинныеДанные(), "");
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	ЮТест.ОжидаетЧто(ТекстОшибки).Заполнено();
	
КонецПроцедуры

// Неизвестное имя настройки вызывает исключение, сообщение называет настройку.
//
Процедура НеизвестнаяНастройкаДаетИсключение() Экспорт
	
	Настройки = qr_QRCode.НастройкиПоУмолчанию();
	Настройки.Вставить("РазмерКода", Настройки.Размер);
	ТекстОшибки = "";
	
	Попытка
		qr_QRCode.СоздатьQRКод(ДанныеЗаписи(), "", Настройки);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, "РазмерКода") > 0).Равно(Истина);
	
КонецПроцедуры

// Значение вне допустимого диапазона отвергает компонента.
//
Процедура НедопустимаяНастройкаДаетИсключение() Экспорт
	
	СлишкомМалыйРазмер = 8;
	
	Настройки = qr_QRCode.НастройкиПоУмолчанию();
	Настройки.Размер = СлишкомМалыйРазмер;
	ТекстОшибки = "";
	
	Попытка
		qr_QRCode.СоздатьQRКод(ДанныеЗаписи(), "", Настройки);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	ЮТест.ОжидаетЧто(ТекстОшибки).Заполнено();
	
КонецПроцедуры

// После отказа следующий вызов работает.
//
Процедура ОтказНеЛомаетСледующийВызов() Экспорт
	
	ТекстОшибки = "";
	
	Попытка
		qr_QRCode.СоздатьQRКод("", "");
	Исключение
		// Отказ ожидаем: проверяется то, что происходит после него.
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	ЮТест.ОжидаетЧто(ТекстОшибки).Заполнено();
	
	Изображение = qr_QRCode.СоздатьQRКод(ДанныеЗаписи(), ВизуальныйКодЗаписи());
	
	ЮТест.ОжидаетЧто(Изображение.Размер() > 0).Равно(Истина);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает запись целиком.
//
// Возвращаемое значение:
//   Строка - строка данных в формате «...|XXXXXXXXYYYY».
//
Функция ДанныеЗаписи()
	
	Запись = ОсноваЗаписи() + ВизуальныйКодЗаписи();
	
	Возврат Запись;
	
КонецФункции

// Возвращает ту же запись без проверочного кода.
//
// Возвращаемое значение:
//   Строка - запись без последних четырех символов.
//
Функция ОсноваЗаписи()
	
	Основа = "2|2000020302|0085F0226|01022031|5RCD6VPE";
	
	Возврат Основа;
	
КонецФункции

// Возвращает проверочный код этой записи.
//
// Возвращаемое значение:
//   Строка - четыре символа проверочного кода.
//
Функция ВизуальныйКодЗаписи()
	
	Код = "AX4R";
	
	Возврат Код;
	
КонецФункции

// Возвращает строку длиннее, чем помещается в QR-код самого большого размера.
//
// Возвращаемое значение:
//   Строка - 5120 символов.
//
Функция ДлинныеДанные()
	
	Данные = "0123456789";
	ПредельнаяДлина = 4096;
	
	Пока СтрДлина(Данные) < ПредельнаяДлина Цикл
		Данные = Данные + Данные;
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

#КонецОбласти
