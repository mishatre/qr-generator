////////////////////////////////////////////////////////////////////////////////
// Пример использования компоненты «Генератор QR-кодов».
//
// Модуль не нужен для работы обертки: он показывает, как вызывать функции модуля
// QRCode и что из них получается. Если пример не нужен, объект просто не
// переносится в конфигурацию - два других модуля от него не зависят.
//
// BSLLS:LatinAndCyrillicSymbolInWord-off
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает изображение QR-кода для записи.
//
// Параметры:
//   Запись - Строка - строка данных в формате «...|XXXXXXXXYYYY».
//   Текст - Строка - подпись в середине кода, обычно визуальный код записи.
//   Фон - Строка - цвет фона, например «#ffffff». Пустая строка - фон прозрачный.
//
// Возвращаемое значение:
//   ДвоичныеДанные - изображение PNG.
//
Функция ИзображениеЗаписи(Запись, Текст = "", Фон = "") Экспорт
	
	Настройки = QRCode.НастройкиПоУмолчанию();
	
	Если Не ПустаяСтрока(Фон) Тогда
		Настройки.Фон = Фон;
	КонецЕсли;
	
	Возврат QRCode.СоздатьQRКод(Запись, Текст, Настройки);
	
КонецФункции

// Возвращает изображение записи в виде картинки платформы.
//
// Параметры:
//   Запись - Строка - строка данных в формате «...|XXXXXXXXYYYY».
//
// Возвращаемое значение:
//   Картинка - картинка с кодом и подписью на белом фоне.
//
Функция КартинкаЗаписи(Запись) Экспорт
	
	Возврат Новый Картинка(ИзображениеЗаписи(Запись, QRCode.ВизуальныйКод(Запись), "#ffffff"));
	
КонецФункции

// Возвращает изображения для нескольких записей, подключив компоненту один раз.
//
// Параметры:
//   Записи - Массив Из Строка - строки данных.
//
// Возвращаемое значение:
//   Массив Из ДвоичныеДанные - изображения в том же порядке, что и записи.
//
Функция ИзображенияЗаписей(Записи) Экспорт
	
	Компонента = QRCode.ПодключитьКомпоненту();
	Изображения = Новый Массив;
	
	Для Каждого Запись Из Записи Цикл
		Изображения.Добавить(
			Компонента.СоздатьQRКод(Запись, QRCode.ВизуальныйКод(Запись), ""));
	КонецЦикла;
	
	Возврат Изображения;
	
КонецФункции

#КонецОбласти
