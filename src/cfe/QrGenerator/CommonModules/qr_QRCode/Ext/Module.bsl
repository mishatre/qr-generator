////////////////////////////////////////////////////////////////////////////////
// Обертка внешней компоненты «Генератор QR-кодов» (Native API, реализация на Rust).
//
// Компонента принимает данные, текст подписи и настройки, а возвращает изображение -
// PNG в виде двоичных данных. Другие типы через Native API не проходят.
//
// Имя объекта компоненты, как его видит платформа, - «AddIn.QrGenerator.QrGenerator».
// Строку «1», которую возвращает функция GetClassNames, платформа использует только
// как идентификатор класса для GetClassObject; видимое имя типа задает сама
// компонента при регистрации.
//
// Безопасный режим. Платформа не позволяет подключать внешние компоненты, пока
// безопасный режим установлен, и снять его из этого модуля нельзя. Поэтому функции
// модуля нельзя вызывать из кода, работающего в безопасном режиме.
//
// Состояние сеанса модуль не хранит: общий модуль расширения не поддерживает
// переменные модуля. Функции генерации подключаются к компоненте через модуль
// qr_QRCodeСерверПовтИсп, в котором подключение повторно используется за сеанс;
// функция ПодключитьКомпоненту подключается заново при каждом вызове.
//
// Причина отказа читается у того же экземпляра компоненты, который создавал значение:
// конструктор Новый(ПолноеИмяОбъектаКомпоненты()) каждый раз создает новый объект.
//
// Настройки отрисовки перечисляет функция НастройкиПоУмолчанию: она возвращает имена
// свойств на русском или английском языке и их значения по умолчанию.
//
// Формат данных. В учетных системах, для которых компонента применяется, строка
// данных имеет вид
//
//	Тип | Код/Артикул | Серия | Срок | XXXXXXXXYYYY
//
// где XXXXXXXX - идентификатор экземпляра, а YYYY - визуальный/проверочный код,
// то есть последние четыре символа строки. Их и рисует компонента, если передать их
// подписью, и их возвращает функция ВизуальныйКод. Проверочный код не случаен: это
// первые двадцать бит SHA-256 от записи без самого кода.
//
// BSLLS:LatinAndCyrillicSymbolInWord-off
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает структуру настроек отрисовки со значениями по умолчанию.
//
// Вызывающий код меняет только те свойства, которые ему нужны, и передает структуру
// третьим аргументом функции СоздатьQRКод. Незнакомое имя настройки вызывает
// исключение.
//
// Параметры:
//   Язык - Строка - «ru» (по умолчанию) - имена свойств по-русски, «en» - по-английски.
//                            Значения от языка не зависят.
//
// Возвращаемое значение:
//   Структура:
//      Размер - Число - сторона квадратного изображения в пикселях.
//      УровеньКоррекцииОшибок - Строка - избыточность кода: «L» - около 7 процентов,
//          «M» - 15, «Q» - 25, «H» - 30. По умолчанию «H».
//      ЗонаПокоя - Число - пустая зона вокруг кода в модулях.
//      РазмерПодписи - Число - сторона подложки подписи как доля стороны изображения.
//      ОтступПодписи - Число - отступ от края подложки до текста в пикселях.
//      СкруглениеПодписи - Число - скругление подложки как доля ее стороны.
//      СтрокПодписи - Число - число строк подписи; 0 - подобрать автоматически.
//      ЦветКода - Строка - цвет модулей в виде «#rrggbb».
//      Фон - Строка - цвет фона в виде «#rrggbb» или «transparent».
//      ЦветПодписи - Строка - цвет текста подписи в виде «#rrggbb».
//      ФонПодписи - Строка - цвет подложки подписи в виде «#rrggbb» или «transparent».
//
// Пример:
//   Настройки = qr_QRCode.НастройкиПоУмолчанию();
//   Настройки.РазмерПодписи = 0.25;
//   Изображение = qr_QRCode.СоздатьQRКод(Данные, "AX4R", Настройки);
//
Функция НастройкиПоУмолчанию(Язык = "ru") Экспорт
	
	Настройки = Новый Структура;
	
	Для Каждого Настройка Из ОписаниеНастроек() Цикл
		Настройки.Вставить(ИмяНастройки(Настройка, Язык), Настройка.Значение);
	КонецЦикла;
	
	Возврат Настройки;
	
КонецФункции

// Полное имя объекта компоненты после подключения.
//
// Возвращаемое значение:
//   Строка - имя для конструктора Новый(), например «AddIn.QrGenerator.QrGenerator».
//
Функция ПолноеИмяОбъектаКомпоненты() Экспорт
	
	Описание = ОписаниеКомпоненты();
	
	Возврат "AddIn." + Описание.ИмяПодключения + "." + Описание.ИмяКласса;
	
КонецФункции

// Подключает компоненту к текущему сеансу и возвращает ее экземпляр.
//
// Подключение выполняется при каждом вызове. Если компонента нужна для многих кодов,
// ее можно подключить один раз и держать объект у себя.
//
// Параметры:
//   Местоположение - Неопределено, Строка, Макет - откуда загружать компоненту.
//       Неопределено (по умолчанию) - макет расширения, имя которого возвращает
//       ОписаниеКомпоненты, с архивом компоненты в виде двоичных данных.
//       Строка - полное имя макета, путь к файлу или URL.
//
// Возвращаемое значение:
//   ВнешняяКомпонента - подключенная компонента.
//
// Вызывает исключение, если вызывающий код работает в безопасном режиме.
//
Функция ПодключитьКомпоненту(Местоположение = Неопределено) Экспорт
	
	Если БезопасныйРежим() = Истина Тогда
		ВызватьИсключение
		"Компоненту «Генератор QR-кодов» нельзя подключить в безопасном режиме.
		|Платформа запрещает загрузку и подключение внешних компонент, пока безопасный
		|режим установлен, а отключить его из этой процедуры нельзя.
		|Подключите компоненту до входа в безопасный режим - например, в начале работы
		|сеанса или в коде, который готовит данные, - и передайте тому коду, который
		|выполняется в безопасном режиме.";
	КонецЕсли;
	
	Описание = ОписаниеКомпоненты();
	
	Если Местоположение = Неопределено Тогда
		Местоположение = "ОбщийМакет." + Описание.ИмяМакета;
	КонецЕсли;
	
	ПодключитьВнешнююКомпоненту(
		Местоположение, Описание.ИмяПодключения, ТипВнешнейКомпоненты.Native);
	
	Возврат Новый(ПолноеИмяОбъектаКомпоненты());
	
КонецФункции

// Возвращает версию компоненты.
//
// Возвращаемое значение:
//   Строка - версия в виде «0.1.0».
//
Функция ВерсияКомпоненты() Экспорт
	
	Возврат КомпонентаQRКода().Версия();
	
КонецФункции

// Создает QR-код с подписью в середине и возвращает изображение.
//
// Параметры:
//   Данные - Строка - то, что кодируется. Пустая строка вызывает исключение.
//   Текст - Строка - подпись в середине кода, обычно визуальный код
//       (см. функцию ВизуальныйКод). Пустая строка - код без подписи.
//   Настройки - Неопределено, Структура - см. НастройкиПоУмолчанию. Неопределено -
//       все значения по умолчанию.
//
// Возвращаемое значение:
//   ДвоичныеДанные - изображение PNG.
//
// Вызывает исключение, если код создать не удалось: причина приходит от компоненты
// и попадает в текст исключения.
//
Функция СоздатьQRКод(Данные, Текст = "", Настройки = Неопределено) Экспорт
	
	Компонента = КомпонентаQRКода();
	
	Изображение = Компонента.СоздатьQRКод(Данные, Текст, НастройкиJSON(Настройки));
	
	ПроверитьИзображение(Компонента, Изображение);
	
	Возврат Изображение;
	
КонецФункции

// Возвращает новый идентификатор экземпляра.
//
// Восемь символов алфавита кодов. Идентификатор выдает компонента: у 1С нет источника
// случайности, на котором построены выпущенные записи.
//
// Возвращаемое значение:
//   Строка - восемь символов, например «5RCD6VPE».
//
// Вызывает исключение, если операционная система отказала в случайных байтах.
//
Функция ИдентификаторЭкземпляра() Экспорт
	
	Компонента = КомпонентаQRКода();
	Идентификатор = Компонента.ИдентификаторЭкземпляра();
	
	Если ПустаяСтрока(Идентификатор) Тогда
		ВызватьИсключение "Не удалось получить идентификатор экземпляра: "
			+ ТекстПоследнейОшибки(Компонента);
	КонецЕсли;
	
	Возврат Идентификатор;
	
КонецФункции

// Вычисляет проверочный код для основы записи.
//
// Основой считается запись без самого кода, включая восьмисимвольный идентификатор
// экземпляра.
//
// Параметры:
//   Основа - Строка - запись без проверочного кода.
//
// Возвращаемое значение:
//   Строка - четыре символа проверочного кода.
//
Функция ПроверочныйКод(Основа) Экспорт
	
	Возврат КомпонентаQRКода().ПроверочныйКод(Основа);
	
КонецФункции

// Возвращает визуальный код записи - последние четыре ее символа.
//
// Параметры:
//   Запись - Строка - строка данных в формате «...|XXXXXXXXYYYY».
//
// Возвращаемое значение:
//   Строка - до четырех последних символов; у короткой строки - вся строка.
//
Функция ВизуальныйКод(Запись) Экспорт
	
	Возврат Прав(Запись, ДлинаПроверочногоКода());
	
КонецФункции

// Проверяет, что запись несет именно тот проверочный код, который из нее следует.
//
// Параметры:
//   Запись - Строка - строка данных целиком.
//
// Возвращаемое значение:
//   Булево - Истина, если код в конце записи совпадает с пересчитанным.
//
Функция КодВерен(Запись) Экспорт
	
	Длина = ДлинаПроверочногоКода();
	
	// У записи короче самого кода основы нет: Лев получил бы отрицательную длину.
	Если СтрДлина(Запись) <= Длина Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Основа = Лев(Запись, СтрДлина(Запись) - Длина);
	
	Возврат ПроверочныйКод(Основа) = ВизуальныйКод(Запись);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает компоненту текущего сеанса.
//
// Подключение выполняет модуль qr_QRCodeСерверПовтИсп, в котором оно повторно
// используется за сеанс.
//
// Возвращаемое значение:
//   ВнешняяКомпонента - подключенная компонента.
//
Функция КомпонентаQRКода()
	
	Возврат qr_QRCodeСерверПовтИсп.ПодключитьКомпонентуQRКода();
	
КонецФункции

// Возвращает описание подключения внешней компоненты.
//
// Возвращаемое значение:
//   Структура:
//      ИмяПодключения - Строка - имя, под которым компонента подключается к сеансу.
//      ИмяКласса - Строка - имя, которое компонента регистрирует за собой
//          (RegisterExtensionAs): платформа составляет из него имя типа объекта.
//      ИмяМакета - Строка - имя общего макета расширения с архивом компоненты.
//
Функция ОписаниеКомпоненты()
	
	Описание = Новый Структура;
	Описание.Вставить("ИмяПодключения", "QrGenerator");
	Описание.Вставить("ИмяКласса", "QrGenerator");
	Описание.Вставить("ИмяМакета", "qr_QrGeneratorNative");
	
	Возврат Описание;
	
КонецФункции

// Возвращает таблицу настроек: русское и английское имена, ключ в JSON компоненты и
// значение по умолчанию.
//
// Таблица - единственное место, где перечислены настройки: из нее собирается и
// структура для вызывающего кода, и JSON для компоненты.
//
// Возвращаемое значение:
//   Массив - элементы-структуры с ключами «ИмяRU», «ИмяEN», «Ключ», «Значение».
//
Функция ОписаниеНастроек()
	
	// BSLLS:MagicNumber-off
	
	Описание = Новый Массив;
	
	ДобавитьНастройку(Описание, "Размер", "Size", "size", 600);
	ДобавитьНастройку(Описание, "УровеньКоррекцииОшибок", "ErrorCorrectionLevel",
		"errorCorrectionLevel", "H");
	ДобавитьНастройку(Описание, "ЗонаПокоя", "QuietZone", "quietZone", 0);
	ДобавитьНастройку(Описание, "РазмерПодписи", "LabelSize", "labelSize", 0.3);
	ДобавитьНастройку(Описание, "ОтступПодписи", "LabelMargin", "labelMargin", 8);
	ДобавитьНастройку(Описание, "СкруглениеПодписи", "LabelRadius", "labelRadius", 0.12);
	ДобавитьНастройку(Описание, "СтрокПодписи", "LabelRows", "labelRows", 0);
	ДобавитьНастройку(Описание, "ЦветКода", "Foreground", "foreground", "#111111");
	ДобавитьНастройку(Описание, "Фон", "Background", "background", "transparent");
	ДобавитьНастройку(Описание, "ЦветПодписи", "LabelColor", "labelColor", "#000000");
	ДобавитьНастройку(Описание, "ФонПодписи", "LabelBackground", "labelBackground",
		"#ffffff");
	
	// BSLLS:MagicNumber-on
	
	Возврат Описание;
	
КонецФункции

// Добавляет описание одной настройки в список.
//
// Параметры:
//   Список - Массив - список описаний, в который добавляется настройка.
//   ИмяRU - Строка - имя настройки по-русски.
//   ИмяEN - Строка - имя настройки по-английски.
//   Ключ - Строка - ключ в JSON, который понимает компонента.
//   Значение - Произвольный - значение по умолчанию.
//
Процедура ДобавитьНастройку(Список, ИмяRU, ИмяEN, Ключ, Значение)
	
	Настройка = Новый Структура;
	Настройка.Вставить("ИмяRU", ИмяRU);
	Настройка.Вставить("ИмяEN", ИмяEN);
	Настройка.Вставить("Ключ", Ключ);
	Настройка.Вставить("Значение", Значение);
	
	Список.Добавить(Настройка);
	
КонецПроцедуры

// Возвращает имя настройки на выбранном языке.
//
// Параметры:
//   Настройка - Структура - описание настройки, см. ОписаниеНастроек.
//   Язык - Строка - «ru» или «en».
//
// Возвращаемое значение:
//   Строка - имя настройки.
//
// Вызывает исключение, если язык не поддерживается.
//
Функция ИмяНастройки(Настройка, Язык)
	
	Если Язык = "ru" Тогда
		Возврат Настройка.ИмяRU;
	ИначеЕсли Язык = "en" Тогда
		Возврат Настройка.ИмяEN;
	Иначе
		ВызватьИсключение СтрШаблон(
			"Неизвестный язык настроек «%1». Поддерживаются «ru» и «en».", Язык);
	КонецЕсли;
	
КонецФункции

// Возвращает ключ настройки в JSON компоненты.
//
// Параметры:
//   Имя - Строка - имя настройки по-русски или по-английски.
//
// Возвращаемое значение:
//   Строка - ключ, который понимает компонента.
//
// Вызывает исключение, если настройка неизвестна.
//
Функция КлючНастройки(Имя)
	
	Для Каждого Настройка Из ОписаниеНастроек() Цикл
		Если Настройка.ИмяRU = Имя ИЛИ Настройка.ИмяEN = Имя Тогда
			Возврат Настройка.Ключ;
		КонецЕсли;
	КонецЦикла;
	
	ВызватьИсключение СтрШаблон(
		"Неизвестная настройка «%1». Список имен возвращает qr_QRCode.НастройкиПоУмолчанию().",
		Имя);
	
КонецФункции

// Пустая строка означает «значения по умолчанию».
//
// Параметры:
//   Настройки - Неопределено, Структура - настройки отрисовки.
//
// Возвращаемое значение:
//   Строка - объект JSON для компоненты.
//
Функция НастройкиJSON(Настройки)
	
	Если Настройки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ДляКомпоненты = Новый Соответствие;
	
	Для Каждого КлючИЗначение Из Настройки Цикл
		ДляКомпоненты.Вставить(КлючНастройки(КлючИЗначение.Ключ), КлючИЗначение.Значение);
	КонецЦикла;
	
	Возврат ЗаписатьJSONЗначение(ДляКомпоненты);
	
КонецФункции

// Записывает значение 1С в строку JSON.
//
// Параметры:
//   Значение - Произвольный - значение, которое нужно сериализовать.
//
// Возвращаемое значение:
//   Строка - значение в виде JSON.
//
Функция ЗаписатьJSONЗначение(Значение)
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	
	ЗаписатьJSON(Запись, Значение);
	
	Возврат Запись.Закрыть();
	
КонецФункции

// Возвращает длину проверочного кода в символах.
//
// Возвращаемое значение:
//   Число - четыре символа.
//
Функция ДлинаПроверочногоКода()
	
	Длина = 4;
	
	Возврат Длина;
	
КонецФункции

// Возвращает причину отказа компоненты.
//
// Параметры:
//   Компонента - ВнешняяКомпонента - тот же экземпляр, у которого спросили значение.
//
// Возвращаемое значение:
//   Строка - текст последней ошибки или объяснение его отсутствия.
//
Функция ТекстПоследнейОшибки(Компонента)
	
	Причина = Компонента.ТекстПоследнейОшибки();
	
	Если ПустаяСтрока(Причина) Тогда
		Возврат "компонента не объяснила причину.";
	КонецЕсли;
	
	Возврат Причина;
	
КонецФункции

// Проверяет, что компонента вернула изображение, и объясняет отказ, если нет.
//
// Пустое изображение означает отказ: настоящий PNG пустым не бывает. Проверяется и
// тип: на неудачном вызове платформа может вернуть Неопределено.
//
// Параметры:
//   Компонента - ВнешняяКомпонента - тот же экземпляр, у которого спросили изображение.
//   Изображение - ДвоичныеДанные - то, что вернула компонента.
//
Процедура ПроверитьИзображение(Компонента, Изображение)
	
	Если ТипЗнч(Изображение) = Тип("ДвоичныеДанные") И Изображение.Размер() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВызватьИсключение "Не удалось создать QR-код: " + ТекстПоследнейОшибки(Компонента);
	
КонецПроцедуры

#КонецОбласти
